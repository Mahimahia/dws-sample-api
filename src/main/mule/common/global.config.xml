	<configuration-properties doc:name="Configuration properties" doc:id="d93f7bdb-c19b-4408-8590-1b87a989dee3" file="global\statuscode.yaml" />
	<secure-properties:config name="Secure_Properties_Config" doc:name="Secure Properties Config" doc:id="139ea189-8d37-4095-aef2-8c416fab3044" file="secure\properties\secure-${env}.yaml" key="${key}" >
		<secure-properties:encrypt algorithm="Blowfish" />
	</secure-properties:config>
	<global-property doc:name="Global Property" doc:id="2a2f33ce-3e77-4518-acae-9726a54cbe47" name="key" value="sync" />
	
